spawn-sh-at-startup "bash -c 'echo detect > /sys/class/drm/card1-DP-3/status'"
spawn-sh-at-startup "env LD_LIBRARY_PATH=/run/opengl-driver/lib noctalia"
spawn-at-startup "nm-applet" "--indicator"

include optional=true "noctalia.kdl"

input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    mouse {
        accel-profile "flat"
    }
    focus-follows-mouse
    warp-mouse-to-focus
}

output "PNP(AOC) CQ27G4 108R3JA004268" {
    mode "2560x1440@180.002"
    position x=0 y=0
    scale 1
    variable-refresh-rate on-demand=true
    focus-at-startup
}

output "Invalid Vendor Codename - RTK ANMITE 0x19201200" {
    mode "1920x1200@60"
    position x=2560 y=-240
    scale 1
    transform "270"
    layout {
        default-column-width { proportion 1.0; }
    }
}

output "Sichuang Changhong Corporation Smart TV 0x00000001" {
    off
}

cursor {
    xcursor-theme "BreezeX-RosePineDawn-Linux"
    xcursor-size 24
}

layout {
    gaps 5
    focus-ring {
        off
    }
    border {
        width 2
    }

    shadow {
        on
        softness 15
        spread 0
        offset x=0 y=2
        color "#1a1a1aee"
    }
}

binds {
    Mod+Return          { spawn "kitty"; }
    Mod+E               { spawn "dolphin"; }
    Mod+Q               { close-window; }
    Mod+B               { toggle-window-floating; }
    Mod+M               { maximize-column; }
    Mod+F               { fullscreen-window; }
    Mod+C               { center-column; }
    Mod+R               { switch-preset-column-width; }
    Mod+Shift+R         { switch-preset-column-width-back; }
    Mod+BracketLeft     { consume-or-expel-window-left; }
    Mod+BracketRight    { consume-or-expel-window-right; }
    Mod+Shift+Slash     { show-hotkey-overlay; }
    Mod+W               { toggle-column-tabbed-display; }  

    Mod+Space   hotkey-overlay-title="Launcher"             { spawn-sh "noctalia msg 'panel-toggle launcher'"; }
    Mod+P       hotkey-overlay-title="Notes"                { spawn-sh "noctalia msg 'panel-toggle noctalia/notes:panel'"; }
    Mod+V       hotkey-overlay-title="Clipboard"            { spawn-sh "noctalia msg 'panel-toggle clipboard'"; }
    Mod+S       hotkey-overlay-title="Control Center"       { spawn-sh "noctalia msg 'panel-toggle control-center'"; }
    Mod+comma   hotkey-overlay-title="Noctalia Settings"    { spawn-sh "noctalia msg settings-toggle"; }
    Mod+L       hotkey-overlay-title="Lock"                 { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+O hotkey-overlay-title="Screenshot (Region)"  { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+P hotkey-overlay-title="Screenshot (Full)"    { spawn-sh "noctalia msg screenshot-fullscreen"; }

    Mod+Escape  { toggle-overview; }

    Mod+Shift+F12 { spawn-sh "~/.local/share/scripts/niri-monitor-menu.sh"; }

    Mod+Left    { focus-column-left; }
    Mod+Right   { focus-column-right; }
    Mod+Up      { focus-window-up; }
    Mod+Down    { focus-window-down; }

    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }

    Mod+Ctrl+Left    { focus-monitor-left; }
    Mod+Ctrl+Right   { focus-monitor-right; }
    Mod+Ctrl+Shift+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    XF86AudioRaiseVolume  { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp   { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }

    Mod+WheelScrollDown                       { focus-column-right; }
    Mod+WheelScrollUp                         { focus-column-left; }
    Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { focus-monitor-next; }
    Mod+Shift+Page_Up   { focus-monitor-previous; }


    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Ctrl+1 { move-window-to-workspace 1; }
    Mod+Ctrl+2 { move-window-to-workspace 2; }
    Mod+Ctrl+3 { move-window-to-workspace 3; }
    Mod+Ctrl+4 { move-window-to-workspace 4; }
    Mod+Ctrl+5 { move-window-to-workspace 5; }
    Mod+Ctrl+6 { move-window-to-workspace 6; }
    Mod+Ctrl+7 { move-window-to-workspace 7; }
    Mod+Ctrl+8 { move-window-to-workspace 8; }
    Mod+Ctrl+9 { move-window-to-workspace 9; }
    Mod+Ctrl+0 { move-window-to-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1 focus=false; }
    Mod+Shift+2 { move-window-to-workspace 2 focus=false; }
    Mod+Shift+3 { move-window-to-workspace 3 focus=false; }
    Mod+Shift+4 { move-window-to-workspace 4 focus=false; }
    Mod+Shift+5 { move-window-to-workspace 5 focus=false; }
    Mod+Shift+6 { move-window-to-workspace 6 focus=false; }
    Mod+Shift+7 { move-window-to-workspace 7 focus=false; }
    Mod+Shift+8 { move-window-to-workspace 8 focus=false; }
    Mod+Shift+9 { move-window-to-workspace 9 focus=false; }
    Mod+Shift+0 { move-window-to-workspace 10 focus=false; }
}

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match title="^(Picture in picture|Picture-in-Picture)$"
    match title="^(Save File|Open File)$"
    match title="^(Steam - Self Updater)$"
    open-floating true
}

window-rule {
    match app-id="kitty"
    opacity 0.9
}

window-rule {
    match app-id="^xdg-desktop-portal-(gtk|kde|hyprland)"
    match app-id="^(polkit-gnome-authentication-agent-1|hyprpolkitagent|org\\.kde\\.polkit-kde-authentication-agent-1)"
    open-floating true
}

window-rule {
    match app-id="^(net-runelite-client-RuneLite|net-runelite-launcher-Launcher)$" title="^RuneLite Launcher$"
    open-floating true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}

layer-rule {
  match namespace="^noctalia-backdrop"
  place-within-backdrop true
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

clipboard {
    disable-primary
}
prefer-no-csd